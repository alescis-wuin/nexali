#!/usr/bin/env bash
set -Eeuo pipefail
repo_root="$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
source "$repo_root/.githooks/lib/policy.sh"
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${remote_ref:-}" ]] || continue
  if [[ "$remote_ref" == refs/heads/* ]]; then
    remote_branch="${remote_ref#refs/heads/}"
    if nexali_is_protected_branch "$remote_branch"; then
      nexali_hook_error "Direct push to protected branch '$remote_branch' is forbidden, including force-push attempts. Use a pull request."
      blocked=1
      continue
    fi
    if [[ "$local_sha" != 0000000000000000000000000000000000000000 ]] && ! nexali_is_valid_topic_branch "$remote_branch"; then
      nexali_hook_error "Remote branch '$remote_branch' violates the <type>/<name> naming convention."
      blocked=1
    fi
  fi
done
[[ "$blocked" -eq 0 ]] || exit 1
